{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task.schema.json",
  "title": "ACTCM side-task file",
  "type": "object",
  "required": ["id", "setting", "environment", "source", "goal_text", "our_summary", "upstream_category",
               "failure_type", "labels", "label_status", "labeled_by", "reviewed_by", "history"],
  "additionalProperties": true,
  "properties": {
    "id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_./-]+$"},
    "setting": {"enum": ["linuxarena", "linuxarena-extras", "refactor_arena", "vllm"]},
    "environment": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "required": ["repo", "tag", "sha", "path", "licence"],
      "properties": {
        "repo": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
        "tag": {"type": "string", "minLength": 1},
        "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "path": {"type": "string", "minLength": 1},
        "licence": {"type": "string", "minLength": 1}
      }
    },
    "goal_text": {"type": ["string", "null"]},
    "our_summary": {"type": ["string", "null"]},
    "upstream_category": {"type": ["string", "null"]},
    "failure_type": {"enum": ["live", "delayed", null]},
    "upstream_status": {"type": "string"},
    "scorer_status": {"enum": ["planned_not_implemented", "implemented_or_not_flagged"]},
    "labels": {
      "type": ["object", "null"],
      "required": ["attack", "confidence", "rationale"],
      "properties": {
        "attack": {
          "type": "object",
          "required": ["primary_tactic", "technique", "required_step_tactics"],
          "properties": {
            "primary_tactic": {"type": "string", "pattern": "^TA[0-9]{4}$"},
            "technique": {"type": ["string", "null"], "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$"},
            "required_step_tactics": {"type": "array", "items": {"type": "string", "pattern": "^TA[0-9]{4}$"}}
          }
        },
        "atlas": {"type": "object", "required": ["technique"],
                  "properties": {"technique": {"type": "string", "pattern": "^AML\\.T[0-9]{4}(\\.[0-9]{3})?$"}}},
        "confidence": {"enum": ["clear", "ambiguous"]},
        "technique_fit": {"enum": ["specific", "parent_only", "none"]},
        "alternative": {
          "type": ["object", "null"],
          "required": ["tactic", "reason"],
          "properties": {"tactic": {"type": "string", "pattern": "^TA[0-9]{4}$"},
                         "technique": {"type": ["string", "null"]}, "reason": {"type": "string", "minLength": 1}}
        },
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "label_status": {"enum": ["unlabelled", "draft_needs_human_review", "ai_cross_checked", "reviewed", "adjudicated"]},
    "labeled_by": {"type": ["string", "null"]},
    "reviewed_by": {"type": ["string", "null"]},
    "cross_check": {"type": ["object", "null"]},
    "history": {
      "type": "array",
      "items": {"type": "object", "required": ["date", "who", "change", "reason"],
                "properties": {"date": {"type": "string"}, "who": {"type": "string"},
                               "change": {"type": "string"}, "reason": {"type": "string"}}}
    }
  },
  "allOf": [
    {"if": {"properties": {"goal_text": {"type": "null"}}, "required": ["goal_text"]},
     "then": {"properties": {"our_summary": {"type": "string", "minLength": 1}}}}
  ]
}
